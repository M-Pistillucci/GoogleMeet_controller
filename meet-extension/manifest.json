{
  "manifest_version": 3,
  "name": "Google Meet StreamController Extension",
  "version": "1.0.0",
  "description": "Bridge tra Google Meet e StreamController",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "*://meet.google.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*;"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.js", "src/*", "src/google-meet/*", "src/google-meet/core/*"],
      "matches": ["*://meet.google.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://meet.google.com/*"],
      "js": ["content_loader.js"]
    }
  ]
}
